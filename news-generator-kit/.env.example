# 复制为 .env 后填写

# —— 必填 ——
OPENAI_API_KEY=sk-xxxxxxxx

# —— 可选：OpenAI 兼容网关 ——
# OPENAI_BASE_URL=https://api.optrouter.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DISCOVERY_MODEL=gpt-4o

# —— 可选：本机代理 ——
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# —— 可选：封面 ——
# UNSPLASH_ACCESS_KEY=

# —— 可选：预览/钉钉链接 ——
# NEXT_PUBLIC_SITE_URL=https://your-site.com

# —— 可选：钉钉播报 ——
# DINGTALK_NEWS_ENABLED=true
# DINGTALK_NEWS_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_NEWS_SECRET=SEC...

# —— 可选：cron ——
# NEWS_CRON_GIT_PUSH=1
# NEXT_REBUILD_HOOK_URL=https://api.vercel.com/...
# NEWS_CRON_LOG=/var/log/news-cron.log

# —— 可选：Next 接收推送 API ——
# RECEIVE_API_KEY=your-secret-key
